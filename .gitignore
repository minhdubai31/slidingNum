# Godot 4 editor cache and export credentials
.godot/
.godot-export-credentials
export_credentials.cfg

# Generated UI screenshots and their editor metadata (keep output folder)
/artifacts/*
!/artifacts/.gdignore

# Exported builds and generated Android build template
/builds/
/android/build/
/android/.build_version
/android/plugins/*.aar
.gradle/
local.properties

# Android signing keys
*.keystore
*.jks

# Python tool caches and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment configuration
.env
.env.*
!.env.example

# Temporary files and OS metadata
*.tmp
*.swp
*.swo
*~
tmp/
.DS_Store
Thumbs.db
Desktop.ini

# Generated Godot Web export (published with the backend)
/backend/public/preview/
