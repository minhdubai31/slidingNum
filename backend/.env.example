# Copy to .env for local runs. On Vercel, set these in the project's Environment Variables.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Keep out of the game and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token for /api/admin/*. Use a long random string, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
