; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Slide · Little moments of order"
config/version="0.6.0"
config/icon="res://assets/third_party/noto/1f9e9.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.96, 0.93, 0.87, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/clear_color=Color(0.957, 0.949, 0.925, 1)

[display]

window/size/viewport_width=430
window/size/viewport_height=900
window/size/window_width_override=430
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
